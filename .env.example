# ============================================================
# .env.example – copie para .env e preencha os valores reais
# NUNCA commite o arquivo .env no Git
# ============================================================

# ── Banco de dados PostgreSQL ────────────────────────────────
URL_DB=jdbc:postgresql://host.containers.internal:5432/capivara
USERNAME_DB=capivara_user
PASSWORD_DB=capivara_pass

# ── Spring Cloud Config – chave SSH para leitura do repositório
# Cole aqui o conteúdo PEM da chave privada, em uma linha só,
# escapando as quebras de linha com \n:
# CAPIVA_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
CAPIVA_SSH_KEY=

# ── Groq API Key (capiva-ai) ─────────────────────────────────
AI_API_KEY_GROQ=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub Personal Access Token (capiva-scalator + capiva-ai MCP) ──
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
