type Query {
    "Busca os N trechos mais similares da base de conhecimento para uma dada query"
    findKnowledgeMatches(query: String!, topK: Int! = 3): [String!]!
}

type Mutation {
    "Envia uma mensagem de suporte e retorna a resposta da IA com o status do ticket"
    ask(input: AskInput!): AskResponse!

    "Adiciona documentos à base de conhecimento (VectorStore)"
    ingestKnowledge(texts: [String!]!): Boolean!

    "Ingere um documento a partir de uma URL de arquivo"
    ingestDocument(fileUrl: String!): Boolean!
}

"Dados completos do chamado enviados pelo MS1"
input AskInput {
    "ID de conversa para manter histórico (chat memory). UUID gerado pelo MS1."
    conversationId: String!
    "Mensagem livre do usuário"
    message: String!
    "Nome do usuário (preenchido via formulário no MS1)"
    userName: String!
    "Título do problema (preenchido via formulário no MS1)"
    title: String!
    "Descrição detalhada do problema (preenchida via formulário no MS1)"
    description: String!
    "Severidade: BAIXA, MEDIA, ALTA ou CRITICA"
    severity: String!
}

"Resposta da IA com a mensagem para o usuário e o status do chamado"
type AskResponse {
    "Resposta textual da IA (sem mencionar GitHub, issues ou ferramentas internas)"
    answer: String!
    "Status do chamado definido pela IA após análise"
    ticketStatus: TicketStatus!
}

"Status do ticket definido pela IA"
enum TicketStatus {
    RESOLVED
    WAITING
    ESCALATED_GITHUB
}
